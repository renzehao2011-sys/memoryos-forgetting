# 数据：不入库（含个人隐私）
data/*
!data/.gitkeep
!data/README.md

# 运行产物
__pycache__/
*.py[cod]
*.log
results/
*.tmp
*.corrupt-*

# 本地配置与密钥（只提交 config.example.json）
config.json
.env
*.env

# 评估产物（由 make_label_sheet.py 生成，含真实文本）
sheet*.tsv
tier_labels.json
tier_labels*.json

# 系统垃圾
.DS_Store
Thumbs.db

# 兜底：数据目录常被“拷到仓库根”而不是放进 data/
data_*/
*copys*/
room_db/
*corpus*/
app_database
*.tsv

# upstream 的 MCP 配置样例里带启动路径，本地版本可能带 key
mcp.json
